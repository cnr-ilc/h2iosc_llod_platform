# 🏭 Ambiente di PRODUZIONE — modello di .env.prod
#
#   make prod-env-init    crea .env.prod: riprende il vecchio .env se c'è (stessa APP_KEY e
#                         password del DB), altrimenti parte da questo file e genera i segreti
#   make prod-check       valida .env.prod (lo fa da solo prima di ogni comando prod-*)
#
# .env.prod è letto da docker-compose.prod.yml (--env-file) e montato in sola lettura come .env
# nei container Laravel. Gli host sono i container dello stack di produzione.
# Le righe con "da compilare" vanno completate prima del deploy (non versionare mai .env.prod).

# =====================================
# 🐳 Docker Compose
# =====================================

# Il progetto prende il nome della cartella (volumi <cartella>_mariadb_data, ...):
# non impostare COMPOSE_PROJECT_NAME senza migrare i volumi.

# Porta dell'app su 127.0.0.1, dietro il reverse proxy dell'host
LARAVEL_PORT=8080

# Cartella con stdata/ (VocBench) e gdbhome/ (GraphDB), montate nei container
VB_DATA_DIR=./vocbench3-docker/volumes

# Architettura delle immagini: quella del server, linux/amd64 o linux/arm64
# (make prod-env-init la imposta da sé; make prod-check segnala se non coincide)
DOCKER_DEFAULT_PLATFORM=linux/amd64

# =====================================
# ⚙️ Laravel
# =====================================

APP_NAME=PLLOD
APP_ENV=production
# Generata da make prod-env-init. Non cambiarla: invalida sessioni e dati cifrati
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# URL pubblico (https) del reverse proxy: da compilare
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =====================================
# 🐬 MariaDB · servizio mariadb (rete interna llod_data)
# =====================================

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=llod
# Utente applicativo creato da MariaDB al primo avvio (root non è ammesso)
DB_USERNAME=pllod
# Generate da make prod-env-init. Valgono solo alla creazione del volume: per cambiarle
# dopo, cambiale anche nel database
DB_PASSWORD=
DB_ROOT_PASSWORD=

# =====================================
# 🧠 Redis · container llod_redis (rete interna llod_data): sessioni, cache e code
# =====================================

REDIS_CLIENT=phpredis
REDIS_HOST=llod_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=pllod

# Horizon elabora solo le code Redis
QUEUE_CONNECTION=redis

HORIZON_PATH=admin/horizon
HORIZON_DOMAIN=null
HORIZON_PREFIX="${APP_NAME}_horizon:"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# =====================================
# 🧬 Servizi dello stack
# =====================================

# VocBench 3 / Semantic Turkey · container vocbench (dall'app)
SEMANTIC_TURKEY_BASE_URL=http://vocbench:1979
# Amministratore di VocBench: da compilare
SEMANTIC_TURKEY_ADMIN_EMAIL=
SEMANTIC_TURKEY_ADMIN_PASSWORD=

# VocBench dal browser: indirizzo pubblico del reverse proxy, da compilare
# (es. https://vocbench.example.org/vocbench3 e .../vocbench3/#/Auth)
VOCBENCH_URL=
VOCBENCH_AUTH_URL=

# GraphDB · servizio graphdb (rete interna llod_graph)
GRAPHDB_HOST_URL=http://graphdb:7200
GRAPHDB_USER=admin
GRAPHDB_PSW=root
GRAPHDB_ACTIVE_REPOSITORY=pllod

# API Python di validazione RDF · container llod_python_api
PY_QUALITY_CHECK_SERVICE_URL=http://llod_python_api:8000

# =====================================
# 🌍 Servizi esterni
# =====================================

# DSpace CLARIN-IT: credenziali da compilare
DSPACE_BASE_URL=https://dspace-clarin-it.ilc.cnr.it/server
DSPACE_USERNAME=
DSPACE_PASSWORD=

# Keycloak CLARIN: il redirect va registrato nel client Keycloak; secret da compilare
KEYCLOAK_BASE_URL=https://vocabs.ilc4clarin.ilc.cnr.it/auth/
KEYCLOAK_REALM=clarin_realm
KEYCLOAK_WELL_KNOWN_URL=https://vocabs.ilc4clarin.ilc.cnr.it/auth/realms/clarin_realm/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=clarin_client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/login/keycloak/callback"
