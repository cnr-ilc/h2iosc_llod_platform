# 💻 Ambiente di SVILUPPO — modello di .env.dev
#
#   make dev-env-init     crea .env.dev da questo file, con APP_KEY e password del DB generate
#   make dev-check        valida .env.dev (lo fa da solo prima di ogni comando dev-*)
#
# .env.dev è letto da docker-compose.dev.yml (--env-file) e montato in sola lettura come .env
# nei container Laravel. Gli host sono i container dello stack: pllod-dev-<servizio>.
# Le righe con "da compilare" vanno completate a mano (non versionare mai .env.dev).

# =====================================
# 🐳 Docker Compose
# =====================================

# Progetto Compose (volumi pllod-dev_*). Per riusare i volumi del vecchio setup
# (pllod-deploy-conf_mariadb_data, ...) imposta COMPOSE_PROJECT_NAME=pllod-deploy-conf
# COMPOSE_PROJECT_NAME=pllod-dev

# Porta dell'app su 127.0.0.1 (deve coincidere con quella di APP_URL)
LARAVEL_PORT=8080

# Cartella con stdata/ (VocBench) e gdbhome/ (GraphDB), montate nei container
VB_DATA_DIR=./vocbench3-docker/volumes

# Architettura delle immagini: linux/amd64 o linux/arm64. make dev-env-init la imposta a quella
# di Docker (su Apple Silicon linux/arm64: immagini native invece dell'emulazione amd64).
# Se la cambi, make dev-up ricostruisce le immagini
DOCKER_DEFAULT_PLATFORM=linux/amd64

# =====================================
# ⚙️ Laravel
# =====================================

APP_NAME=PLLOD
APP_ENV=local
# Generata da make dev-env-init
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =====================================
# 🐬 MariaDB · container pllod-dev-mariadb (rete interna llod_data)
# =====================================

DB_CONNECTION=mysql
DB_HOST=pllod-dev-mariadb
DB_PORT=3306
DB_DATABASE=llod
# Utente applicativo creato da MariaDB al primo avvio (root non è ammesso)
DB_USERNAME=pllod
# Generate da make dev-env-init. Valgono solo alla creazione del volume: per cambiarle
# dopo, cambiale anche nel database (o azzera con make dev-reset)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# =====================================
# 🧠 Redis · container pllod-dev-redis (rete interna llod_data): sessioni, cache e code
# =====================================

REDIS_CLIENT=phpredis
REDIS_HOST=pllod-dev-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=pllod

# Horizon elabora solo le code Redis
QUEUE_CONNECTION=redis

HORIZON_PATH=admin/horizon
HORIZON_DOMAIN=null
HORIZON_PREFIX="${APP_NAME}_horizon:"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# =====================================
# 🧬 Servizi dello stack
# =====================================

# VocBench 3 / Semantic Turkey · container pllod-dev-vocbench (dall'app)
SEMANTIC_TURKEY_BASE_URL=http://pllod-dev-vocbench:1979
# Amministratore di VocBench: quello dei dati di sviluppo in vocbench3-docker/volumes/stdata
# (se parti da dati vuoti è l'utente creato al primo accesso a VocBench)
SEMANTIC_TURKEY_ADMIN_EMAIL=admin@vocbench.com
SEMANTIC_TURKEY_ADMIN_PASSWORD=admin

# VocBench dal browser (porta pubblicata su 127.0.0.1)
VOCBENCH_URL=http://localhost:1979/vocbench3
VOCBENCH_AUTH_URL="http://localhost:1979/vocbench3/#/Auth"

# GraphDB · container pllod-dev-graphdb (rete interna llod_graph)
GRAPHDB_HOST_URL=http://pllod-dev-graphdb:7200
GRAPHDB_USER=admin
GRAPHDB_PSW=root
GRAPHDB_ACTIVE_REPOSITORY=pllod

# API Python di validazione RDF · container pllod-dev-python-api
PY_QUALITY_CHECK_SERVICE_URL=http://pllod-dev-python-api:8000

# =====================================
# 🌍 Servizi esterni
# =====================================

# DSpace CLARIN-IT: credenziali da compilare
DSPACE_BASE_URL=https://dspace-clarin-it.ilc.cnr.it/server
DSPACE_USERNAME=
DSPACE_PASSWORD=

# Keycloak CLARIN: il redirect va registrato nel client Keycloak; secret da compilare
KEYCLOAK_BASE_URL=https://vocabs.ilc4clarin.ilc.cnr.it/auth/
KEYCLOAK_REALM=clarin_realm
KEYCLOAK_WELL_KNOWN_URL=https://vocabs.ilc4clarin.ilc.cnr.it/auth/realms/clarin_realm/.well-known/openid-configuration
KEYCLOAK_CLIENT_ID=clarin_client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI="${APP_URL}/login/keycloak/callback"
